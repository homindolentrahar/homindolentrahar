---
import { type CollectionEntry } from "astro:content";
import { slugify } from "../../utils/slugify";

interface Props {
  entry: CollectionEntry<"works">;
  showPortfolio?: boolean;
}

const { entry, showPortfolio = true } = Astro.props;
const data = entry.data;
---

<div
  class="p-4 border border-gray-200 rounded-sm flex flex-col justify-between"
>
  <div class="flex flex-col items-start">
    <p class="text-xs text-gray-500">
      {data.stacks.slice(0, 3).join(" • ")}
    </p>
    <a
      href=`/works/${slugify(data.name)}`
      class="text-xl font-semibold text-black line-clamp-2 overflow-ellipsis mt-3 hover:underline underline-offset-4 transition-all duration-200"
    >
      {data.name}
    </a>
    <p class="mt-1 text-sm text-gray-400 line-clamp-2 overflow-ellipsis">
      {data.desc}
    </p>
  </div>
  {
    showPortfolio && (
      <div class="mt-16 flex flex-col gap-1">
        <p class="text-sm">Resources:</p>
        <ul class="list-disc grid grid-cols-2">
          {data.portfolio.map((item) => (
            <li class="ms-4">
              <a
                href={item.url}
                target="_blank"
                class="text-xs hover:underline underline-offset-4 text-gray-500 hover:text-black hover:font-medium transition-all duration-200"
              >
                {item.type}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>
