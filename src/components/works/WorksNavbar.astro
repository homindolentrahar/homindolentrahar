---
import NavbarItem from "../NavbarItem.svelte";

interface HomeNavbarMenu {
  title: string;
  path: string;
}

const menus: HomeNavbarMenu[] = [
  {
    title: "Works",
    path: "works",
  },
  {
    title: "About",
    path: "about",
  },
  {
    title: "Experience",
    path: "experience",
  },
  {
    title: "Leet",
    path: "leet",
  },
  {
    title: "Error Log",
    path: "error-log",
  },
];
---

<nav
  class="bg-white border-b border-gray-100 flex flex-row fixed w-full top-0 z-50"
>
  {
    menus.map((menu) => (
      <NavbarItem client:load targetId={menu.path}>
        {menu.title}
      </NavbarItem>
    ))
  }
</nav>
