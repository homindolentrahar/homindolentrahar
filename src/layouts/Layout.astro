---
import "../styles/global.css";
import "@fontsource-variable/space-grotesk";
import Footer from "../components/Footer.astro";
import Navbar, { type NavbarMenu } from "../components/Navbar.astro";

const homeNavbarMenu: NavbarMenu[] = [
  {
    title: "Works",
    path: "works",
  },
  {
    title: "About",
    path: "about",
  },
  {
    title: "Experience",
    path: "experience",
  },
  {
    title: "Leet",
    path: "leet",
  },
  {
    title: "Error Log",
    path: "error-log",
  },
];

const worksNavbarMenu: NavbarMenu[] = [];

const navbarMenus: {
  [key: string]: { showBackToHome?: boolean; navbarMenuList: NavbarMenu[] };
} = {
  "/": {
    showBackToHome: false,
    navbarMenuList: homeNavbarMenu,
  },
  "/works": {
    showBackToHome: true,
    navbarMenuList: worksNavbarMenu,
  },
  "/about": {
    showBackToHome: true,
    navbarMenuList: homeNavbarMenu,
  },
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>homindolentrahar</title>
  </head>
  <body>
    <!-- <Navbar
      showBackToHome={navbarMenus[currentPath].showBackToHome}
      navbarMenuList={navbarMenus[currentPath].navbarMenuList}
    /> -->
    <main
      class="flex flex-col place-self-center lg:w-6/12 h-screen overflow-visible"
    >
      <slot />
      <Footer />
    </main>
  </body>
</html>
