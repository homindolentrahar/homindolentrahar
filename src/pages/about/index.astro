---
import { slugify } from "../../utils/slugify";
import Layout from "../../layouts/Layout.astro";
import NavbarLayout from "../../components/NavbarLayout.astro";
import NavbarItem from "../../components/NavbarItem.svelte";
import AboutExperienceSection from "../../components/about/AboutExperienceSection.astro";

const menus = ["Education", "Experience", "Course", "Skills", "Beyond Code"];
---

<Layout>
  <NavbarLayout showBackToHome={true}>
    {
      menus.map((menu) => (
        <NavbarItem client:load targetId={slugify(menu)}>
          {menu}
        </NavbarItem>
      ))
    }
  </NavbarLayout>
  <section class="flex flex-col mt-16 py-8">
    <h1 class="text-4xl font-bold">
      There's only better <span class="underline underline-offset-4"
        >iteration</span
      >.
    </h1>
    <p class="text-sm text-gray-500 mt-4 mb-8">
      Just modest developer who enjoys untangling complex problems with code.
      Specialized in Mobile and Frontend Web, but always curious to explore
      more. While not coding, I love walking, watching movies, idolling, and
      sporadically debugging my life decisions.
    </p>

    <AboutExperienceSection />
  </section>
</Layout>
