---
import Layout from "../layouts/Layout.astro";
import HomeHeroSection from "../components/home/HomeHeroSection.astro";
import HomeWorksSection from "../components/home/HomeWorksSection.astro";
import HomeAboutSection from "../components/home/HomeAboutSection.astro";
import HomeExpSection from "../components/home/HomeExpSection.astro";
import HomeLeetSection from "../components/home/HomeLeetSection.astro";
import HomeErrorLogSection from "../components/home/HomeErrorLogSection.astro";
import NavbarLayout from "../components/NavbarLayout.astro";
import NavbarItem from "../components/NavbarItem.svelte";
import { slugify } from "../utils/slugify";

const menus = ["Works", "About", "Experience", "Leet", "Error Log"];
---

<Layout>
  <NavbarLayout>
    {
      menus.map((menu) => (
        <NavbarItem client:load targetId={slugify(menu)}>
          {menu}
        </NavbarItem>
      ))
    }
  </NavbarLayout>
  <section class="flex flex-col mt-8">
    <HomeHeroSection />
    <HomeWorksSection />
    <HomeAboutSection />
    <HomeExpSection />
    <HomeLeetSection />
    <HomeErrorLogSection />
  </section>
</Layout>
